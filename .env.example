# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: override defaults
# FRONTEND_ORIGIN=http://localhost:5173
# BACKEND_PUBLIC_URL=http://localhost:8000

# Set to true wherever the app is served over HTTPS, so the session cookie
# carries the Secure flag and never travels in the clear.
# COOKIE_SECURE=false
# LOG_LEVEL=INFO

# Largest profile picture accepted, in bytes. What gets stored is the
# re-encoded 512px square, which is far smaller than this.
# AVATAR_MAX_UPLOAD_BYTES=5242880
